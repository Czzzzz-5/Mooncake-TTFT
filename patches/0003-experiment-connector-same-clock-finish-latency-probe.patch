+import json
+import time
+
+from vllm.logger import init_logger
+
+_logger = init_logger(__name__)
+
+
+def ttft_event(req_id, event, role="engine", extra=None):
+    entry = {
+        "ts_ns": time.perf_counter_ns(),
+        "event": event,
+        "role": role,
+    }
+    if req_id is not None:
+        entry["req_id"] = req_id
+    if extra:
+        entry.update(extra)
+    _logger.info("[TTFT] %s", json.dumps(entry, ensure_ascii=False))
