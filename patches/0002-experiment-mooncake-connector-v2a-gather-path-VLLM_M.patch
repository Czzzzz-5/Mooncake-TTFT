+    def _gather_eligible(
+        self,
+        agent_meta: MooncakeXferMetadata,
+        gather_plan: _GatherPlan,
+    ) -> bool:
+        """Whether this batch can use the single-descriptor gather path."""
+        if gather_plan.total_bytes == 0:
+            return False
+        capacity = min(self._gather_buf_bytes, agent_meta.gather_buffer_size)
+        if gather_plan.total_bytes > capacity:
+            logger.warning_once(
+                "Mooncake gather: batch of %d bytes exceeds the gather buffer "
+                "capacity %d bytes; falling back to per-descriptor transfer.",
+                gather_plan.total_bytes,
+                capacity,
+            )
+            return False
+        return True
+
+    def _gather_and_send_blocks(
+        self,
+        remote_session: str,
+        remote_buffer_addr: int,
+        gather_plan: _GatherPlan,
+        req_order: list[ReqId],
+    ) -> tuple[int | None, dict[ReqId, MooncakeGatherManifest] | None]:
+        """Pack scattered KV blocks into the pinned gather buffer and push
+        them to the consumer's gather buffer as a single descriptor.
+
+        Layout contract: requests are packed in req_order; within a request,
+        segments follow plan order, which is the exact aligned-region and
+        paired-block order in which _build_transfer_params emits per-block
+        descriptors. Each segment holds its region's block payloads
+        (transfer_len bytes each) concatenated in paired block order. The
+        returned manifests describe this layout so the consumer can scatter
+        the bytes back into its GPU blocks.
+
+        Returns (None, None) if the gather itself failed; the caller must
+        then fall back to the per-descriptor path. On transfer failure the
+        manifests are dropped so the consumer never scatters stale bytes.
+        """
+        try:
+            with self._gather_lock:
+                assert self._gather_buffer is not None
+                buf = self._gather_buffer
+                offset = 0
+                num_segments = 0
+                manifests: dict[ReqId, MooncakeGatherManifest] = {}
+                for req_id in req_order:
+                    segments = gather_plan.segments.get(req_id)
+                    if not segments:
+                        continue
+                    manifest = MooncakeGatherManifest(buf_offset=offset, segments=[])
+                    for seg in segments:
+                        region = seg.local_region
+                        cache = self._find_cache_for_addr(region.base_addr)
+                        _gather_blocks_to_buffer(
+                            buf,
+                            offset,
+                            cache,
+                            seg.local_block_ids,
+                            region.block_len,
+                            region.base_addr - cache.data_ptr() + seg.src_region_offset,
+                            seg.transfer_len,
+                        )
+                        seg_bytes = seg.transfer_len * len(seg.local_block_ids)
+                        manifest.segments.append(
+                            MooncakeGatherSegment(
+                                layer_name=region.layer_name,
+                                layer_index=region.layer_index,
+                                occurrence=seg.occurrence,
+                                byte_len=seg_bytes,
+                            )
+                        )
+                        offset += seg_bytes
+                        num_segments += 1
+                    manifests[req_id] = manifest
+                torch.cuda.synchronize()
+                logger.info(
+                    "[XDBG] P_GATHER_DONE t=%d bytes=%d segs=%d",
+                    time.time_ns(),
+                    offset,
+                    num_segments,
+                )
+                ret_value = self._send_blocks(
+                    remote_session, [buf.data_ptr()], [remote_buffer_addr], [offset]
+                )
+        except Exception:
+            logger.exception(
+                "Mooncake gather failed; disabling it and falling back to "
+                "per-descriptor transfer."
+            )
+            self._gather_broken = True
+            return None, None
+        return ret_value, (manifests if ret_value == 0 else None)
+
+    def _find_cache_for_addr(self, addr: int) -> torch.Tensor:
+        """Return the registered KV cache tensor whose storage holds addr."""
+        for cache_or_caches in self.device_kv_caches.values():
+            caches = (
+                cache_or_caches
+                if isinstance(cache_or_caches, (tuple, list))
+                else (cache_or_caches,)
+            )
+            for cache in caches:
+                storage = cache.untyped_storage()
+                storage_addr = storage.data_ptr()
+                if storage_addr <= addr < storage_addr + storage.nbytes():
+                    return cache
+        raise RuntimeError(
+            f"Address {addr} is not inside any registered KV cache storage."
+        )
+
+    def _remote_block_ids_for_scatter(
+        self, block_ids_per_group: list[list[int]]
+    ) -> list[list[int]]:
+        """Recompute the consumer-side block id lists the producer used,
+        mirroring the NULL-block filtering in _build_transfer_params."""
+        group_specs = self.kv_cache_config.kv_cache_groups
+        return [
+            (
+                [block_id for block_id in group if block_id != NULL_BLOCK_ID]
+                if isinstance(group_specs[i].kv_cache_spec, MambaSpec)
+                else list(group)
+            )
+            for i, group in enumerate(block_ids_per_group)
+        ]
+
+    def _scatter_gathered_buffer(
+        self,
+        manifests: dict[ReqId, MooncakeGatherManifest],
+        pull_metas: dict[ReqId, PullReqMeta],
+    ) -> set[ReqId]:
+        """Scatter gather-buffer bytes back into local GPU KV blocks.
+
+        Runs before the affected requests are marked as received, preserving
+        the "applied at destination" semantics of the per-descriptor path.
+        Returns the set of requests whose scatter failed; those are not
+        marked finished.
+        """
+        if self._gather_buffer is None:
+            logger.error(
+                "Received gather manifests but no gather buffer is registered; "
+                "affected requests will not complete: %s",
+                sorted(manifests),
+            )
+            return set(manifests)
+        failed: set[ReqId] = set()
+        current_platform.set_device(self.device_id)
+        with self._gather_lock:
+            buf = self._gather_buffer
+            total_bytes = 0
+            num_segments = 0
+            for req_id, manifest in manifests.items():
+                pull_meta = pull_metas.get(req_id)
+                if pull_meta is None:
+                    logger.error("Gather manifest for unknown request %s", req_id)
+                    failed.add(req_id)
+                    continue
+                try:
+                    block_ids_by_group = self._logical_to_kernel_block_ids(
+                        self._remote_block_ids_for_scatter(pull_meta.local_block_ids)
+                    )
+                    offset = manifest.buf_offset
+                    for seg in manifest.segments:
+                        region = self._gather_regions_by_key.get(
+                            (seg.layer_name, seg.occurrence)
+                        )
+                        if region is None or region.layer_index != seg.layer_index:
+                            raise RuntimeError(
+                                f"Gather segment {seg.layer_name} occurrence "
+                                f"{seg.occurrence} does not match the local KV "
+                                "cache registration."
+                            )
+                        block_ids = block_ids_by_group[region.group_index]
+                        if len(block_ids) * region.kv_block_len != seg.byte_len:
+                            raise RuntimeError(
+                                f"Gather segment size mismatch for "
+                                f"{seg.layer_name}: manifest={seg.byte_len}, "
+                                f"local={len(block_ids) * region.kv_block_len}."
+                            )
+                        cache = self._find_cache_for_addr(region.base_addr)
+                        _scatter_buffer_to_blocks(
+                            buf,
+                            offset,
+                            cache,
+                            block_ids,
+                            region.block_len,
+                            region.base_addr - cache.data_ptr(),
+                            region.kv_block_len,
+                        )
+                        offset += seg.byte_len
+                        num_segments += 1
+                    total_bytes += offset - manifest.buf_offset
+                except Exception:
+                    logger.exception(
+                        "Failed to scatter gathered KV for request %s.", req_id
+                    )
+                    failed.add(req_id)
+            torch.cuda.synchronize()
+            logger.info(
+                "[XDBG] D_SCATTER_DONE t=%d bytes=%d segs=%d",
+                time.time_ns(),
+                total_bytes,
+                num_segments,
+            )
+        if failed:
+            self.xfer_stats.record_failed_recv()
+        return failed
+
+    def _register_gather_buffer(self) -> None:
+        """Allocate the pinned gather buffer and register it with Mooncake."""
+        if self._gather_buf_bytes <= 0:
+            return
+        try:
+            buf = torch.empty(
+                self._gather_buf_bytes, dtype=torch.uint8, pin_memory=True
+            )
+            ret_value = self.engine.register_memory(buf.data_ptr(), buf.numel())
+            if ret_value != 0:
+                raise RuntimeError(f"register_memory returned {ret_value}")
+        except Exception as e:
+            logger.warning(
+                "Mooncake gather buffer setup failed (%s); "
+                "VLLM_MOONCAKE_GATHER is disabled.",
+                e,
+            )
+            self._gather_buf_bytes = 0
+            self._gather_buffer = None
+            return
+        self._gather_buffer = buf
+        logger.info(
+            "Mooncake gather buffer: %d MiB pinned at %#x",
+            self._gather_buf_bytes >> 20,
+            buf.data_ptr(),
+        )
+
+    def _build_gather_region_lookup(self) -> None:
+        """Map (layer_name, occurrence) to the local transfer region, using
