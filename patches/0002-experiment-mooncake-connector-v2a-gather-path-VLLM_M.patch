     return None
 
 
+def _gather_blocks_to_buffer(
+    buf: torch.Tensor,
+    buf_offset: int,
+    cache: torch.Tensor,
+    block_ids: list[int],
+    block_len: int,
+    payload_offset: int,
+    payload_len: int,
+) -> None:
+    """Pack per-block payloads of one region into a flat (pinned) buffer.
+
+    Bytes land at buf[buf_offset : buf_offset + len(block_ids) * payload_len]
+    as the concatenation, in block_ids order, of each block's payload: the
+    payload_len bytes at cache byte offset block_id * block_len +
+    payload_offset. The consumer must replay the exact same order when
+    scattering the buffer back into its own blocks.
+    """
+    assert cache.is_contiguous(), "Mooncake gather requires contiguous KV caches"
+    num_blocks = len(block_ids)
+    blocks = cache.view(torch.uint8).view(-1, block_len)
+    ids = torch.tensor(block_ids, dtype=torch.int64, device=cache.device)
+    payload = blocks[:, payload_offset : payload_offset + payload_len].index_select(
+        0, ids
+    )
+    dst = buf[buf_offset : buf_offset + num_blocks * payload_len].view(
+        num_blocks, payload_len
+    )
+    dst.copy_(payload, non_blocking=True)
+
+
+def _scatter_buffer_to_blocks(
+    buf: torch.Tensor,
+    buf_offset: int,
+    cache: torch.Tensor,
+    block_ids: list[int],
+    block_len: int,
+    payload_offset: int,
+    payload_len: int,
+) -> None:
+    """Inverse of _gather_blocks_to_buffer: write packed payloads back into
+    the given blocks of a KV cache tensor."""
+    assert cache.is_contiguous(), "Mooncake scatter requires contiguous KV caches"
+    num_blocks = len(block_ids)
+    blocks = cache.view(torch.uint8).view(-1, block_len)
+    ids = torch.tensor(block_ids, dtype=torch.int64, device=cache.device)
+    src = (
+        buf[buf_offset : buf_offset + num_blocks * payload_len]
+        .view(num_blocks, payload_len)
+        .to(cache.device, non_blocking=True)
+    )
+    blocks[:, payload_offset : payload_offset + payload_len].index_copy_(0, ids, src)
+
