+    def _build_gather_table(
+        self,
+        gather_plan: _GatherPlan,
+        req_order: list[ReqId],
+    ) -> tuple[list[int], list[int], dict[ReqId, MooncakeGatherManifest], int]:
+        """Flatten the gather plan into (gpu_addrs, lengths) plus manifests.
+
+        Pure CPU: no copies. The engine packs the segments in list order,
+        which is exactly the layout the manifests describe.
+        """
+        src_ptrs: list[int] = []
+        lens: list[int] = []
+        offset = 0
+        manifests: dict[ReqId, MooncakeGatherManifest] = {}
+        for req_id in req_order:
+            segments = gather_plan.segments.get(req_id)
+            if not segments:
+                continue
+            manifest = MooncakeGatherManifest(buf_offset=offset, segments=[])
+            for seg in segments:
+                region = seg.local_region
+                for block_id in seg.local_block_ids:
+                    src_ptrs.append(
+                        region.base_addr
+                        + seg.src_region_offset
+                        + block_id * region.block_len
+                    )
+                    lens.append(seg.transfer_len)
+                seg_bytes = seg.transfer_len * len(seg.local_block_ids)
+                manifest.segments.append(
+                    MooncakeGatherSegment(
+                        layer_name=region.layer_name,
+                        layer_index=region.layer_index,
+                        occurrence=seg.occurrence,
+                        byte_len=seg_bytes,
+                    )
+                )
+                offset += seg_bytes
+            manifests[req_id] = manifest
+        return src_ptrs, lens, manifests, offset
