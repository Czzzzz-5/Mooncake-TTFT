+// --- Phase timing (measurement-only patch for the A/B against the --------
+// gpu-staging-v1 branch; NOT for upstream). Enabled by MC_TCP_PHASE_TIMING=1.
+// Accumulates per-request nanoseconds spent in CUDA staging copies (copy_ns:
+// the "GPU<->host" phases PH1/PH3) and in socket I/O waits (io_ns: the
+// network phase PH2), then logs one [MC-PHASE] line per completed request.
+// Off by default; when off the only cost is one cached flag check per chunk.
+static bool phaseTimingEnabled() {
+    static const bool val = [] {
+        const char* env = std::getenv("MC_TCP_PHASE_TIMING");
+        return env && env[0] == '1';
+    }();
+    return val;
+}
+
+struct PhaseTimer {
+    uint64_t copy_ns = 0;
+    uint64_t io_ns = 0;
+    std::chrono::steady_clock::time_point start;
+};
+
+static inline std::chrono::steady_clock::time_point phaseNow(bool enabled) {
+    return enabled ? std::chrono::steady_clock::now()
+                   : std::chrono::steady_clock::time_point{};
+}
+
+static inline uint64_t phaseElapsedNs(
+    std::chrono::steady_clock::time_point t0) {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now() - t0)
+        .count();
+}
+
+static void logPhaseTiming(const char* side, const char* op, uint64_t bytes,
+                           const PhaseTimer& tm, const char* status) {
+    double total_ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
+                                                  tm.start)
+            .count();
+    LOG(INFO) << "[MC-PHASE] side=" << side << " op=" << op
+              << " bytes=" << bytes << " copy_ms=" << tm.copy_ns / 1e6
+              << " io_ms=" << tm.io_ns / 1e6 << " total_ms=" << total_ms
+              << " status=" << status;
+}
+
